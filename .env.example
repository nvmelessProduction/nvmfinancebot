# Copia questo file in ".env" e riempi i valori. Il file .env non va mai
# messo su git: contiene la password del conto e il segreto del webhook.

# ---------------------------------------------------------------------------
# Modalita' operativa: dry_run | semi | auto
#   dry_run  non tocca MT5, registra e stampa soltanto   <-- default, il piu' sicuro
#   semi     notifica su Telegram e si ferma, aspetta conferma manuale
#   auto     esegue davvero gli ordini
# ---------------------------------------------------------------------------
MODE=dry_run

# ---------------------------------------------------------------------------
# Webhook TradingView
# WEBHOOK_SECRET e' l'unica cosa che separa il conto da chiunque conosca l'URL.
# Inventane uno lungo e casuale, e mettilo identico nel JSON dell'alert.
# Se resta vuoto, /webhook rifiuta tutto.
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Telegram (facoltativo: se manca, i messaggi finiscono a console)
# TELEGRAM_TOKEN lo da' @BotFather. Per TELEGRAM_CHAT_ID: scrivi al tuo bot,
# poi apri https://api.telegram.org/bot<TOKEN>/getUpdates e leggi "chat":{"id":...}
# ---------------------------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# MetaTrader 5 / FP Markets
# Se lasci MT5_LOGIN=0 il bot si aggancia al terminale gia' aperto e loggato
# a mano: e' il modo piu' semplice e non ti fa scrivere la password qui.
# MT5_PATH serve solo se hai piu' terminali installati.
# ---------------------------------------------------------------------------
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC=20260901

# ---------------------------------------------------------------------------
# Archivio SQLite e rete
# ---------------------------------------------------------------------------
DB_PATH=bot.db
TIMEOUT_HTTP=10.0

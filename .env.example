# Copia questo file come .env nella cartella del bot e completa i valori.
# Il file .env resta solo sul tuo computer: non va mai condiviso ne' caricato online.

# Telegram: il bot principale (da @BotFather) e i due canali
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_EQUIPE=

# Facoltativi: un bot per ogni agente, per vederli scrivere col loro nome nel gruppo equipe
TELEGRAM_TOKEN_CAPO=
TELEGRAM_TOKEN_GRILLETTO=
TELEGRAM_TOKEN_RISCHIO=
TELEGRAM_TOKEN_CACCIATORE=
TELEGRAM_TOKEN_LIVELLI=
TELEGRAM_TOKEN_KEY_LEVEL=
TELEGRAM_TOKEN_ORARIO=
TELEGRAM_TOKEN_BIAS=
TELEGRAM_TOKEN_ALLINEAMENTO=
TELEGRAM_TOKEN_GAP=

# Se il broker chiama i simboli con un suffisso (per esempio EURUSD.a), scrivilo qui: .a
MT5_SUFFISSO_SIMBOLI=

# Facoltativo: analizzare sui grafici di TradingView invece che sui prezzi di MT5 (gli ordini restano su MT5).
# I grafici come li scrivete su TradingView, separati da virgole. Se il nome dopo i due punti non e' quello del
# bot, scrivi il nome del bot dopo l'uguale (OANDA:US30USD=US30). Prima fai il login con tradingview_accesso.bat.
# Finche' TradingView non da' il permesso scritto, il bot propone e apre solo col vostro pulsante «Apri».
TRADINGVIEW_SIMBOLI=
# Il grafico del dollaro su TradingView (vuoto: TVC:DXY)
TRADINGVIEW_DXY=

# Facoltativo: per mandare i dati dal vivo alla palestra settimanale
GITHUB_TOKEN=

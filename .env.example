# Copia questo file in ".env" e riempi i valori. Il file .env non va mai
# messo su git: contiene la password del conto e il segreto del webhook.

# ===========================================================================
# MODALITA' OPERATIVA: dry_run | semi | auto
#   dry_run  non tocca MT5, registra e stampa soltanto   <-- default, il piu' sicuro
#   semi     notifica su Telegram e si ferma, aspetta conferma manuale
#   auto     esegue davvero gli ordini
# ===========================================================================
MODE=dry_run

# ===========================================================================
# WEBHOOK TRADINGVIEW
# WEBHOOK_SECRET e' l'unica cosa che separa il conto da chiunque conosca
# l'URL. Inventane uno lungo e casuale, e mettilo identico nel JSON
# dell'alert. Se resta vuoto, /webhook rifiuta tutto.
#   Per generarne uno:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================================================
WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=8000

# ===========================================================================
# TELEGRAM (facoltativo: se manca, i messaggi finiscono solo nel log)
# TELEGRAM_TOKEN lo da' @BotFather. Per TELEGRAM_CHAT_ID: scrivi al tuo bot,
# poi apri https://api.telegram.org/bot<TOKEN>/getUpdates e leggi "chat":{"id":...}
# ===========================================================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TENTATIVI=3

# ===========================================================================
# METATRADER 5 / FP MARKETS
# Se lasci MT5_LOGIN=0 il bot si aggancia al terminale gia' aperto e loggato
# a mano: e' il modo piu' semplice e non ti fa scrivere la password qui.
# MT5_PATH serve solo se hai piu' terminali installati.
# Ricorda comunque di attivare il pulsante "Algo Trading" su MT5.
# ===========================================================================
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC=20260901
MT5_DEVIAZIONE=20

# ===========================================================================
# SALVAGUARDIE
# Nessuna di queste apre posizioni: possono solo impedirne l'apertura.
# Mettere 0 disattiva il controllo (sconsigliato in modalita' auto).
# ===========================================================================

# FRENO A MANO. Se esiste un file con questo nome nella cartella del
# progetto, il bot smette di inviare ordini. Funziona a server acceso: basta
# creare il file. Continua invece a sorvegliare stop e target di cio' che e'
# gia' aperto, perche' un'emergenza non e' un buon momento per smettere di
# proteggere le posizioni.
#   Per tirarlo:   type nul > STOP      (Windows)
#   Per mollarlo:  del STOP
FILE_BLOCCO=STOP

# Un alert consegnato in ritardo descrive un prezzo che non esiste piu'.
# Oltre questi secondi viene archiviato ma non eseguito.
MAX_RITARDO_ALERT_SEC=180

# Tetto anti-errore sul volume del singolo ordine, in lotti. Non calcola la
# size: rifiuta e basta, se qualcuno chiede un volume fuori scala.
VOLUME_MASSIMO=1.0

# Quante posizioni il bot puo' tenere aperte contemporaneamente.
MAX_POSIZIONI_APERTE=5

# ===========================================================================
# SENTINELLA DI STOP E TARGET
# Sul broker non ci sono ordini pendenti: i livelli stanno in archivio e li
# sorveglia questo ciclo. Se la spegni, stop e target non esistono.
# ===========================================================================
SENTINELLA_ATTIVA=true
SENTINELLA_INTERVALLO_SEC=5.0

# ===========================================================================
# FORNITORE DEI DATI DI ANALISI
#
#   nessuno  il motore non riceve dati e si astiene dichiarandolo (default)
#   mt5      legge le candele dal terminale MetaTrader 5
#
# ATTENZIONE su "mt5": MT5 di FP Markets serve CFD, non future CME. DEF-32,
# come corretta da REV-13, impone il future su tutti i timeframe. Con questo
# fornitore la macchina gira su dati veri di mercato vero, ma i prezzi non
# sono quelli che la strategia prescrive: serve a far funzionare l'impianto e
# a scoprire i problemi pratici, NON a misurare se la strategia funziona.
# La non conformita' viene scritta nel log all'avvio e mostrata in /salute.
#
# Il suffisso dei simboli lo scopri con:  python prova_esecuzione.py
# ===========================================================================
FORNITORE_DATI=nessuno
MT5_SUFFISSO_SIMBOLI=

# ===========================================================================
# ARCHIVIO, DIARIO DI BORDO E RETE
# ===========================================================================
DB_PATH=bot.db
LOG_FILE=bot.log
LOG_LIVELLO=INFO
LOG_MAX_BYTE=5000000
LOG_COPIE=5
TIMEOUT_HTTP=10.0
